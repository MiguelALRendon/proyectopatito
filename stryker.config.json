{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.d.ts",
    "!src/main.ts",
    "!src/documents/monaco/**",
    "!src/documents/pdf/**",
    "!src/documents/markdown/xssCorpus.ts"
  ],
  "reporters": ["clear-text", "html"],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 85
  },
  "ignorePatterns": [
    "src-tauri/target",
    "src-tauri/target-e2e",
    "src-tauri/gen",
    "coverage",
    "reports",
    "dist",
    "tests/e2e",
    ".stryker-tmp"
  ]
}
